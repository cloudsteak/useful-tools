# Másold le .env néven a jira-random-task-generator mappába, és töltsd ki.
# A .env-et a .gitignore kizárja - a benne lévő secretek nem kerülnek be a repóba.

# -- Jira Cloud ----------------------------------------------------------
# A Space URL-jéből: https://<domain>.atlassian.net/jira/software/projects/<KEY>
JIRA_BASE_URL=https://cloudmentorhu.atlassian.net
JIRA_EMAIL=you@example.com
# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# -- Vertex AI (Gemini) ---------------------------------------------------
GOOGLE_CLOUD_PROJECT=
# Vertex AI régió (default: europe-west1, ha üresen hagyod)
GOOGLE_CLOUD_LOCATION=europe-west1
# Gemini modell (default: gemini-2.5-pro, ha üresen hagyod)
GEMINI_MODEL=gemini-2.5-pro
# Csak akkor add meg, ha tudod, hogy a modelled csak globálisan érhető el
# (pl. GEMINI_LOCATION=global) - egyébként hagyd üresen, a tool automatikusan
# 'global'-ra vált, ha GOOGLE_CLOUD_LOCATION-nel nem sikerül.
GEMINI_LOCATION=
